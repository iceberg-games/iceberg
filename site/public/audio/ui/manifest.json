    "play":          { "files": ["ui_play_button"],  "gain": 1.0, "ms": 550, "minIntervalMs": 250 },
    "popup_open":    { "files": ["ui_popup_open"],   "gain": 0.85, "ms": 240, "minIntervalMs": 80 },
    "popup_close":   { "files": ["ui_popup_close"],  "gain": 0.8, "ms": 220, "minIntervalMs": 80 },
    "notification":  { "files": ["ui_notification"], "gain": 0.9, "ms": 550, "minIntervalMs": 300 },
    "toast":         { "files": ["ui_toast"],        "gain": 0.85, "ms": 200, "minIntervalMs": 120 },
    "error":         { "files": ["ui_error"],        "gain": 0.9, "ms": 400, "minIntervalMs": 250 }
  },
  "publisherAliases": {
    "click.ogg": "ui_click_1", "play.ogg": "ui_play_button", "popup-open.ogg": "ui_popup_open",
